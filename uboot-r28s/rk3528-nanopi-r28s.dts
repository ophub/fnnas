// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Device Tree for FriendlyELEC NanoPi R28S (RK3528A) — mainline U-Boot
 *
 * 模板: 主线 rk3528-nanopi-zero2.dts (同 SoC RK3528A)
 * 硬件定义: friendlyarm/kernel-rockchip nanopi6-v6.1.y / rk3528-nanopi-rev03.dts
 *
 * ★R28S 与 Zero2 在 U-Boot 阶段的关键差异: 调试串口★
 *   Zero2 用 UART0(0xff9f0000, serial0), R28S 用 UART2(0xffa0000, m1 引脚组, serial2).
 *   之前用 Zero2 u-boot 卡 'Starting kernel' 的根因之一就是串口节点对不上.
 *
 * 设计说明 (最小化以降低编译/启动风险):
 *   U-Boot 只需 DDR + UART2 + eMMC(sdhci)/SD(sdmmc) + 电源树正确即可点亮.
 *   网口 gmac1 保留(基本可用), 但 PCIe/RTL8111H、SDIO0 WiFi 等外设不在此配置——
 *   它们由内核 dtb(已验证的 rk3528-nanopi-r28s.dtb)接管, u-boot 阶段无需初始化,
 *   且可避免引用主线下游 pinctrl 中命名未确认的 label(如 eth_pins/pciem1_pins)导致 dtc 报错.
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/pwm/pwm.h>
#include "rk3528.dtsi"

/ {
	model = "FriendlyELEC NanoPi R28S";
	compatible = "friendlyelec,nanopi-r28s", "rockchip,rk3528";

	aliases {
		ethernet0 = &gmac1;
		mmc0 = &sdhci;
		mmc1 = &sdmmc;
		serial0 = &uart0;
		serial2 = &uart2;
	};

	chosen {
		/* R28S 调试串口为 UART2 (USB-UART), 1500000 8N1 */
		stdout-path = "serial2:1500000n8";
	};

	/* USER(C) 按键: gpio4 RK_PB2 低有效 */
	keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&key1_pin>;

		button-user {
			label = "user";
			linux,code = <BTN_1>;
			gpios = <&gpio4 RK_PB2 GPIO_ACTIVE_LOW>;
			debounce-interval = <50>;
			wakeup-source;
		};
	};

	/* 板载 3 个 GPIO LED: SYS(gpio4 PB0) / LED1(PB1) / LED2(PB3), 高有效 */
	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&led_sys>, <&led1>, <&led2>;

		led-0 {
			gpios = <&gpio4 RK_PB0 GPIO_ACTIVE_HIGH>;
			label = "sys_led";
			linux,default-trigger = "heartbeat";
			default-state = "on";
		};

		led-1 {
			gpios = <&gpio4 RK_PB1 GPIO_ACTIVE_HIGH>;
			label = "lan_led";
		};

		led-2 {
			gpios = <&gpio4 RK_PB3 GPIO_ACTIVE_HIGH>;
			label = "wan_led";
		};
	};

	/* ---- 板级 regulator (与 Zero2 一致, RK3528 nanopi 系列共用电源树) ---- */
	vcc0v6_ddr: regulator-0v6-vcc-ddr {
		compatible = "regulator-fixed";
		regulator-name = "vcc0v6_ddr";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <600000>;
		regulator-max-microvolt = <600000>;
		vin-supply = <&vcc5v0_sys>;
	};

	vdd_0v9: regulator-0v9-vdd {
		compatible = "regulator-fixed";
		regulator-name = "vdd_0v9";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <900000>;
		regulator-max-microvolt = <900000>;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc_ddr: regulator-1v1-vcc-ddr {
		compatible = "regulator-fixed";
		regulator-name = "vcc_ddr";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1100000>;
		regulator-max-microvolt = <1100000>;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc_1v8: regulator-1v8-vcc {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v8";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vcc_3v3>;
	};

	vcc_3v3: regulator-3v3-vcc {
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc3v3_sd: regulator-3v3-vcc-sd {
		compatible = "regulator-fixed";
		gpios = <&gpio4 RK_PA1 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&sdmmc_pwren_l>;
		regulator-name = "vcc3v3_sd";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc_3v3>;
	};

	vcc5v0_sys: regulator-5v0-vcc-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
	};

	vccio_sd: regulator-vccio-sd {
		compatible = "regulator-gpio";
		gpios = <&gpio4 RK_PB6 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&sdmmc_vol_ctrl_h>;
		regulator-name = "vccio_sd";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <3300000>;
		states = <1800000 0x0>, <3300000 0x1>;
		vin-supply = <&vcc5v0_sys>;
	};

	vdd_arm: regulator-vdd-arm {
		compatible = "pwm-regulator";
		pwms = <&pwm1 0 5000 PWM_POLARITY_INVERTED>;
		pwm-supply = <&vcc5v0_sys>;
		regulator-name = "vdd_arm";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <746000>;
		regulator-max-microvolt = <1201000>;
		regulator-settling-time-up-us = <250>;
	};

	vdd_logic: regulator-vdd-logic {
		compatible = "pwm-regulator";
		pwms = <&pwm2 0 5000 PWM_POLARITY_INVERTED>;
		pwm-supply = <&vcc5v0_sys>;
		regulator-name = "vdd_logic";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <705000>;
		regulator-max-microvolt = <1006000>;
		regulator-settling-time-up-us = <250>;
	};
};

&cpu0 { cpu-supply = <&vdd_arm>; };
&cpu1 { cpu-supply = <&vdd_arm>; };
&cpu2 { cpu-supply = <&vdd_arm>; };
&cpu3 { cpu-supply = <&vdd_arm>; };

/* ---- 网口1: SoC 内置 gmac1, RGMII 接 RTL8211F 千兆 PHY (R28S 时序) ---- */
&gmac1 {
	clock_in_out = "output";
	phy-handle = <&rgmii_phy>;
	phy-mode = "rgmii-rxid";
	tx_delay = <0x30>;
	pinctrl-names = "default";
	pinctrl-0 = <&rgmii_miim>, <&rgmii_tx_bus2>, <&rgmii_rx_bus2>,
		    <&rgmii_rgmii_clk>, <&rgmii_rgmii_bus>;
	status = "okay";
};

&mdio1 {
	rgmii_phy: ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x1>;
		realtek,ledsel = <0xae00>;
		pinctrl-names = "default";
		pinctrl-0 = <&gmac1_rstn_l>;
		reset-assert-us = <20000>;
		reset-deassert-us = <100000>;
		reset-gpios = <&gpio4 RK_PC2 GPIO_ACTIVE_LOW>;
	};
};

&gpu {
	mali-supply = <&vdd_logic>;
	status = "okay";
};

/* RTC: HYM8563 @ i2c1 */
&i2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1m0_xfer>;
	status = "okay";

	hym8563: rtc@51 {
		compatible = "haoyu,hym8563";
		reg = <0x51>;
		#clock-cells = <0>;
		clock-frequency = <32768>;
		clock-output-names = "hym8563";
		interrupt-parent = <&gpio4>;
		interrupts = <RK_PC1 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&rtc_int_l>;
		wakeup-source;
	};
};

&pinctrl {
	ethernet {
		gmac1_rstn_l: gmac1-rstn-l {
			rockchip,pins = <4 RK_PC2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	keys {
		key1_pin: key1-pin {
			rockchip,pins = <4 RK_PB2 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	leds {
		led_sys: led-sys {
			rockchip,pins = <4 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		led1: led1 {
			rockchip,pins = <4 RK_PB1 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		led2: led2 {
			rockchip,pins = <4 RK_PB3 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	rtc {
		rtc_int_l: rtc-int-l {
			rockchip,pins = <4 RK_PC1 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	sdmmc {
		sdmmc_vol_ctrl_h: sdmmc-vol-ctrl-h {
			rockchip,pins = <4 RK_PB6 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		sdmmc_pwren_l: sdmmc-pwren-l {
			rockchip,pins = <4 RK_PA1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&pwm1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm1m0_pins>;
	status = "okay";
};

&pwm2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm2m0_pins>;
	status = "okay";
};

&saradc {
	vref-supply = <&vcc_1v8>;
	status = "okay";
};

/* eMMC (sdhci, 8bit HS200) */
&sdhci {
	bus-width = <8>;
	cap-mmc-highspeed;
	mmc-hs200-1_8v;
	no-sd;
	no-sdio;
	non-removable;
	vmmc-supply = <&vcc_3v3>;
	vqmmc-supply = <&vcc_1v8>;
	status = "okay";
};

/* microSD (sdmmc) */
&sdmmc {
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;
	sd-uhs-sdr104;
	vmmc-supply = <&vcc3v3_sd>;
	vqmmc-supply = <&vccio_sd>;
	status = "okay";
};

/* 调试串口: R28S 用 UART2 (m1 引脚组), 1500000 */
&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart2m1_xfer>, <&uart2m1_ctsn>, <&uart2m1_rtsn>;
	status = "okay";
};

/* 注: USB (usb_host0/usb2phy) 在主线 rk3528.dtsi 中尚无节点定义,
 * 且 u-boot 点亮 R28S 不需要 USB (USB-C 仅供电/刷机, 由内核阶段接管),
 * 故不在此配置, 避免引用主线不存在的 label 导致 dtc 报错. */
